[
    ["cjk", "\u4e2d\u6587"],
    ["emoji", "\ud83d\ude00"],
    ["4-byte-across-block", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\ud83d\ude00"]
]
""")

write_file(
    name = "digests",
    out = "digests.txt",
    content = [
        "{} {} {} {}".format(
            name,
            len(text),
            algorithm,
            getattr(hashes, algorithm)(text),
        )
        for name, text in _CASES
        for algorithm in [
            "blake3",
            "md5",
            "sha1",
            "sha256",
            "crc32",
            "sha224",
            "sha512",
            "sha384",
            "sha512_224",
            "sha512_256",
            "sha3_224",
            "sha3_256",
            "sha3_384",
            "sha3_512",
