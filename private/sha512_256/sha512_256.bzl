"""SHA-512/256 (FIPS 180-4) implemented in pure Starlark for portability."""

load("//private:bytes.bzl", "to_bytes")
load("//private:hex.bzl", "hex_words64_be")
load("//private/sha512:sha512.bzl", "sha512_words")

# --- SHA-512/256 Initial Hash Values ---
# FIPS 180-4 5.3.6.2; generated by the SHA-512/t IV generation function
# (5.3.6) with t = 256.
_IV = [
    0x22312194FC2BF72C,
    0x9F555FA3C84C64C2,
    0x2393B86B6F53B151,
    0x963877195940EABD,
    0x96283EE2A88EFFE3,
    0xBE5E1E2553863992,
    0x2B0199FC2C85B8AA,
    0x0EB72DDC81C52CA2,
]

def sha512_256(input):
    """Computes the SHA-512/256 digest of a byte string.

    Args:
        input: The byte string to hash; see hashes.bzl.

    Returns:
        The digest as 64 lowercase hex characters.
    """

    # SHA-512 with its own initial hash values, truncated to the first 4 words.
    return hex_words64_be(sha512_words(to_bytes(input), _IV)[:4])
