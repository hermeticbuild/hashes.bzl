"""SHA-512/224 (FIPS 180-4) implemented in pure Starlark for portability."""

load("//private:bytes.bzl", "to_bytes")
load("//private:hex.bzl", "hex_words64_be")
load("//private/sha512:sha512.bzl", "sha512_words")

# --- SHA-512/224 Initial Hash Values ---
# FIPS 180-4 5.3.6.1; generated by the SHA-512/t IV generation function
# (5.3.6) for t = 224.
_IV = [
    0x8C3D37C819544DA2,
    0x73E1996689DCD4D6,
    0x1DFAB7AE32FF9C82,
    0x679DD514582F9FCF,
    0x0F6D2B697BD44DA8,
    0x77E36F7304C48942,
    0x3F9D85A86A1D36C8,
    0x1112E6AD91D692A1,
]

def sha512_224(input):
    """Computes the SHA-512/224 digest of a byte string.

    Args:
        input: The byte string to hash; see hashes.bzl.

    Returns:
        The digest as 56 lowercase hex characters.
    """

    # SHA-512 with its own initial hash values, truncated to the leftmost 224
    # bits: three and a half words, so format four and drop the last 8 hex
    # characters.
    return hex_words64_be(sha512_words(to_bytes(input), _IV)[:4])[:56]
